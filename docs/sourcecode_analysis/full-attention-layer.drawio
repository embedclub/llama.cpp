        <mxCell id="note_causal" value="&lt;b&gt;关键点&lt;/b&gt;&lt;br&gt;• prefill 与 decode 走同一套图：&lt;br&gt;&amp;nbsp;&amp;nbsp;区别只是 K/V 的 token 数&lt;br&gt;• KV Cache 让历史 K/V 不必重算&lt;br&gt;• 计算复杂度：O(n&lt;sup&gt;2&lt;/sup&gt;·d)（每层）&lt;br&gt;• Flash Attention 开启时：&lt;br&gt;&amp;nbsp;&amp;nbsp;KQ / softmax / KQV 融合为&lt;br&gt;&amp;nbsp;&amp;nbsp;ggml_flash_attn_ext()&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/llama-graph.cpp:1952-1970&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="560" width="340" height="210" as="geometry" />
        </mxCell>

        <mxCell id="note_ffn" value="&lt;b&gt;FFN 分支&lt;/b&gt;&lt;br&gt;• 普通模型：gate/up/down 三层 MLP&lt;br&gt;• MoE 模型：build_moe_ffn()&lt;br&gt;&amp;nbsp;&amp;nbsp;先 router 选 expert，再分组计算&lt;br&gt;• 残差在 FFN 之前就已保存（ffn_inp）" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
