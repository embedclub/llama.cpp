        <mxCell id="res_edge1" value="残差（skip linear attention）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="input" target="res1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="270" y="140" />
              <mxPoint x="270" y="1090" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="res_edge2" value="残差（skip FFN）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeWidth=2;strokeColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="res1" target="res2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="1090" />
              <mxPoint x="950" y="1360" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note_delta" value="&lt;b&gt;Delta Net 的三种实现&lt;/b&gt;&lt;br&gt;build_delta_net() 按 token 数与编译开关选择：&lt;br&gt;&lt;br&gt;• n_seq_tokens == 1 且 fused_gdn_ar：&lt;br&gt;&amp;nbsp;&amp;nbsp;build_delta_net_fused()&lt;br&gt;• n_seq_tokens == 1：&lt;br&gt;&amp;nbsp;&amp;nbsp;build_delta_net_autoregressive()&lt;br&gt;• n_seq_tokens &gt; 1 且 fused_gdn_ch：&lt;br&gt;&amp;nbsp;&amp;nbsp;build_delta_net_fused()&lt;br&gt;• n_seq_tokens &gt; 1：&lt;br&gt;&amp;nbsp;&amp;nbsp;build_delta_net_chunking()（chunk=64/16）&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/delta-net-base.cpp:423-445&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="620" width="380" height="260" as="geometry" />
        </mxCell>

        <mxCell id="note_state" value="&lt;b&gt;与 Full Attention 的本质区别&lt;/b&gt;&lt;br&gt;• 没有 K/V Cache，不保存历史 token&lt;br&gt;• 只保存固定大小循环状态：&lt;br&gt;&amp;nbsp;&amp;nbsp;S ∈ R&lt;sup&gt;S_v×S_v×H_v&lt;/sup&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;conv_state ∈ R&lt;sup&gt;(K-1)×C&lt;/sup&gt;&lt;br&gt;• 每 token 计算量恒定，复杂度 O(n·d&lt;sup&gt;2&lt;/sup&gt;)&lt;br&gt;• prefill 用 chunked 并行，decode 用单步递推" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="990" y="920" width="380" height="190" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
