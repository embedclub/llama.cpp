  <diagram id="linear-attn-layer" name="Linear Attention 单层">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Linear Attention 单层执行流程（以 Qwen3-Next Gated Delta Net 为例）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="源码：src/models/qwen3next.cpp · src/models/delta-net-base.cpp · llama-memory-recurrent" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;&lt;font color='#82b366'&gt;■&lt;/font&gt; 归一化 / 输入输出&lt;br&gt;&lt;font color='#6c8ebf'&gt;■&lt;/font&gt; 线性投影&lt;br&gt;&lt;font color='#d79b00'&gt;■&lt;/font&gt; 短卷积 / 状态缓存&lt;br&gt;&lt;font color='#9673a6'&gt;■&lt;/font&gt; Delta Net 核心&lt;br&gt;&lt;font color='#b85450'&gt;■&lt;/font&gt; 残差相加&lt;br&gt;&lt;font color='#d6b656'&gt;■&lt;/font&gt; FFN" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#fafafa;strokeColor=#999999;fontSize=11;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="210" height="150" as="geometry" />
        </mxCell>

        <mxCell id="input" value="输入隐藏状态 h&lt;sub&gt;in&lt;/sub&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;embedding 或上一层输出&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="110" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="attn_norm" value="RMSNorm（attn_norm）&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:21 · build_norm(LLM_NORM_RMS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="200" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="qkvz" value="QKVZ 线性投影&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:181-260 · build_qkvz()&lt;br&gt;一次投影出 Q、K、V 与门控 z（wqkv + wqkv_gate）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="290" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ba" value="β / α 投影&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:285-325&lt;br&gt;β = sigmoid(b)&lt;br&gt;gate = -A · softplus(α + dt)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="380" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="conv" value="Short Conv + SiLU，并更新卷积状态&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:328-390&lt;br&gt;concat(conv_state, qkv) → ggml_ssm_conv → SiLU&lt;br&gt;最后 K-1 个位置写回 conv_state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="470" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="split" value="拆分 Q / K / V，L2 归一化&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:392-435&lt;br&gt;q_conv、k_conv 做 ggml_l2_norm()&lt;br&gt;num_k_heads ≠ num_v_heads 时 repeat 对齐&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="570" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="delta" value="Delta Net 核心 build_delta_net()&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/delta-net-base.cpp:423-445&lt;br&gt;输入：q, k, v, gate, beta, state&lt;br&gt;输出：output, new_state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="670" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="state_update" value="写回循环状态 S（无 KV Cache）&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:445-451 · ggml_cpy()&lt;br&gt;S ∈ R&lt;sup&gt;S_v×S_v×H_v&lt;/sup&gt;，按 seq_id 存到 recurrent memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="780" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="gated_norm" value="Gated RMSNorm（用 z 门控）&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:90-99, 455&lt;br&gt;RMSNorm(output) ⊙ SiLU(z)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="880" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="out_proj" value="输出投影 ssm_out&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:462 · build_lora_mm(ssm_out)&lt;br&gt;回到隐藏维度 n_embd&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="970" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="res1" value="残差相加 #1&lt;br&gt;attn_residual = linear_attn_out + h&lt;sub&gt;in&lt;/sub&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:40&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="1060" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="post_norm" value="RMSNorm（attn_post_norm）&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:47 · build_norm(LLM_NORM_RMS)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="1150" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ffn" value="FFN（Dense 或 MoE）&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:471 · build_layer_ffn()&lt;br&gt;无内部残差，残差在外部相加&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="1240" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="res2" value="残差相加 #2&lt;br&gt;l_out = ffn_out + attn_residual&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:55-56&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="1330" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="output" value="输出到下一层（或 final norm + LM head）&lt;br&gt;&lt;font style='font-size:10px;color:#666666'&gt;src/models/qwen3next.cpp:68-88&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="410" y="1420" width="500" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="input" target="attn_norm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeWidth=2;strokeColor=#333333;" edge="1" parent="1" source="attn_norm" target="qkvz">
          <mxGeometry relative="1" as="geometry" />
